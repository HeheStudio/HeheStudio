# Copy to .env for local testing with `netlify dev`.
# On the live site, set these in Netlify: Site configuration → Environment variables.
# Never commit the real values.

# Stripe → Developers → API keys (use the sk_test_ key while testing)
STRIPE_SECRET_KEY=sk_test_...

# Allowed price range in GBP. Orders outside it are refused.
MIN_PRICE=50
MAX_PRICE=5000
