# Copy to .env for local testing with `netlify dev`.
# On the live site, set these in Netlify: Site configuration → Environment variables.
# Never commit the real values.

# Stripe → Developers → API keys (use the sk_test_ key while testing)
STRIPE_SECRET_KEY=sk_test_...

# ShapeDiver model → Settings → Developers: backend ticket + model view URL
SHAPEDIVER_BACKEND_TICKET=
SHAPEDIVER_MODEL_VIEW_URL=https://sdr8euc1.eu-central-1.shapediver.com

# Optional: name of a Grasshopper data output holding the price.
# Leave empty to use the price of the App Builder "Add to cart" action.
SHAPEDIVER_PRICE_OUTPUT=
